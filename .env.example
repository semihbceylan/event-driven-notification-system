# Copy to .env and edit. docker compose reads .env automatically.

# Offer your webhook.site URL as a second provider, next to the built-in
# mock. Switch between them in the dashboard or with PUT /v1/provider.
# A free webhook.site URL accepts only 50 requests in total (retries
# included) and expires after 7 days, so keep load tests on the mock.
# WEBHOOK_SITE_URL=https://webhook.site/your-uuid

# Provider used until one is selected: mock or webhook.site
DEFAULT_PROVIDER=mock

# Mock provider behaviour (fraction of requests that fail, and response delay)
MOCK_FAILURE_RATE=0.1
MOCK_LATENCY=30ms

LOG_LEVEL=info
